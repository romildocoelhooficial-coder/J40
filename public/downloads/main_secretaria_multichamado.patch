+    @staticmethod
+    def _sec_norm_texto(texto: str) -> str:
+        s = unicodedata.normalize("NFD", str(texto or "").lower())
+        s = "".join(c for c in s if unicodedata.category(c) != "Mn")
+        return " ".join("".join(c if c.isalnum() else " " for c in s).split())
+
+    @classmethod
+    def _sec_chave_id(cls, cid, nome: str = "") -> str:
+        s = str(cid).strip() if cid is not None else ""
+        if s:
+            return s
+        n = cls._sec_norm_texto(nome)
+        return f"nome:{n}" if n else "_padrao"
+
+    @classmethod
+    def _sec_chave_pid(cls, pid, cid=None, nome: str = "") -> str:
+        s = str(pid).strip() if pid is not None else ""
+        if s:
+            return s
+        return f"pid:{cls._sec_chave_id(cid, nome)}"
+
+    def _sec_limpar_expiradas(self, agora: float | None = None) -> None:
+        agora = time.monotonic() if agora is None else agora
+        with self._sec_garantir_estado():
+            exp_c = [k for k, v in self._sec_chamadas.items() if agora >= float(v.get("ate") or 0)]
+            for k in exp_c:
+                self._sec_chamadas.pop(k, None)
+            exp_p = [k for k, v in self._sec_perguntas.items() if agora >= float(v.get("ate") or 0)]
+            for k in exp_p:
+                self._sec_perguntas.pop(k, None)
+
+    def _sec_casar_item(self, itens: list, dica: str = "", exigir_match: bool = False):
+        if not itens:
+            return None
+        dica_raw = str(dica or "").strip()
+        if dica_raw:
+            for item in reversed(itens):
+                if dica_raw in (
+                    str(item.get("cid") or ""),
+                    str(item.get("id") or ""),
+                    str(item.get("pid_key") or ""),
+                    str(item.get("pid") or ""),
+                ):
+                    return item
+            dica_norm = self._sec_norm_texto(dica_raw)
+            if dica_norm:
+                melhor = None
+                melhor_pontos = 0
+                palavras_dica = set(dica_norm.split())
+                for item in itens:
+                    nome_norm = self._sec_norm_texto(item.get("nome") or "")
+                    if not nome_norm:
+                        continue
+                    pontos = 0
+                    if nome_norm == dica_norm:
+                        pontos = 100
+                    elif f" {nome_norm} " in f" {dica_norm} ":
+                        pontos = 80 + len(nome_norm)
+                    else:
+                        partes = [p for p in nome_norm.split() if len(p) >= 3]
+                        hits = sum(1 for p in partes if p in palavras_dica)
+                        if hits:
+                            pontos = 40 + hits * 10
+                    if pontos > melhor_pontos or (pontos and pontos == melhor_pontos):
+                        melhor_pontos = pontos
+                        melhor = item
+                if melhor is not None:
+                    return melhor
+        return None if exigir_match else itens[-1]
+
+    def _sec_payload_resumo(self) -> dict:
+        with self._sec_garantir_estado():
+            self._sec_limpar_expiradas()
+            return {
+                "ativas": len(self._sec_em_ligacoes),
+                "tocando": len(self._sec_chamadas),
+                "perguntas": len(self._sec_perguntas),
+                "chamadas_ativas": [
+                    {"id": v.get("id"), "nome": v.get("nome"), "quem": v.get("quem")}
+                    for v in self._sec_em_ligacoes.values()
+                ],
+                "chamadas_tocando": [
+                    {"id": v.get("id"), "nome": v.get("nome"), "auto": v.get("auto")}
+                    for v in self._sec_chamadas.values()
+                ],
+                "perguntas_pendentes": [
+                    {"pid": v.get("pid"), "id": v.get("id"), "nome": v.get("nome"), "pergunta": v.get("pergunta")}
+                    for v in self._sec_perguntas.values()
+                ],
+            }
+
+    def _sec_atualizar_tela_restante(self, cid_removido=None, esconder_se_vazio: bool = True) -> None:
+        proximo = None
+        resumo = {}
+        with self._sec_garantir_estado():
+            self._sec_limpar_expiradas()
+            if self._sec_perguntas:
+                q = list(self._sec_perguntas.values())[-1]
+                espera = max(1, int(round(float(q.get("ate") or 0) - time.monotonic())))
+                proximo = {
+                    "estado": "pergunta",
+                    "id": q.get("id"),
+                    "pid": q.get("pid"),
+                    "nome": q.get("nome"),
+                    "pergunta": q.get("pergunta"),
+                    "espera": espera,
+                }
+            elif self._sec_chamadas:
+                c = list(self._sec_chamadas.values())[-1]
+                proximo = {
+                    "estado": "tocando",
+                    "id": c.get("id"),
+                    "nome": c.get("nome"),
+                    "auto": c.get("auto"),
+                }
+            elif self._sec_em_ligacoes:
+                e = list(self._sec_em_ligacoes.values())[-1]
+                proximo = {
+                    "estado": "atendeu",
+                    "id": e.get("id"),
+                    "nome": e.get("nome"),
+                    "quem": e.get("quem"),
+                    "voz": e.get("voz"),
+                }
+            resumo = self._sec_payload_resumo()
+        if proximo is not None:
+            proximo.update(resumo)
+            self._tela_secretaria(proximo)
+        elif esconder_se_vazio:
+            self._tela_secretaria({"estado": "esconder", "id": cid_removido, **resumo})
+
+    def _sec_silenciar(self, cid: str) -> None:
+        emitir = False
+        with self._sec_garantir_estado():
+            ja_mutado_pela_sec = bool(getattr(self, "_sec_mutou", False))
+            if ja_mutado_pela_sec or not getattr(self.ui, "muted", False):
+                self._sec_mutou_ids.add(cid)
+                if not ja_mutado_pela_sec:
+                    self._sec_mutou = True
+                    emitir = True
+        if emitir:
+            self._tela_secretaria({"estado": "mudo", "valor": True})
