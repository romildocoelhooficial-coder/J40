+    def _sec_garantir_estado(self):
+        lock = getattr(self, "_sec_lock", None)
+        if lock is None:
+            lock = threading.RLock()
+            self._sec_lock = lock
+        if not hasattr(self, "_sec_chamadas"):
+            self._sec_chamadas = {}
+        if not hasattr(self, "_sec_perguntas"):
+            self._sec_perguntas = {}
+        if not hasattr(self, "_sec_em_ligacoes"):
+            self._sec_em_ligacoes = {}
+        if not hasattr(self, "_sec_mutou_ids"):
+            self._sec_mutou_ids = set()
+        if not hasattr(self, "_sec_mutou"):
+            self._sec_mutou = False
+        return lock
+
+    @property
+    def _sec_chamada(self):
+        with self._sec_garantir_estado():
+            self._sec_limpar_expiradas()
+            itens = list(self._sec_chamadas.values())
+            return dict(itens[-1]) if itens else None
+
+    @property
+    def _sec_pergunta(self):
+        with self._sec_garantir_estado():
+            self._sec_limpar_expiradas()
+            itens = list(self._sec_perguntas.values())
+            return dict(itens[-1]) if itens else None
+
+    @property
+    def _sec_em_ligacao(self):
+        with self._sec_garantir_estado():
+            itens = [v for v in self._sec_em_ligacoes.values() if v.get("quem") == "secretaria"]
+            return dict(itens[-1]) if itens else None
